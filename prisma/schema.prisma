datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SurveyResponse {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  role      String
  answers   String
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
}
